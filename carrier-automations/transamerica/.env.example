# TransAmerica Agent Portal Credentials
# Primary portal: TransACT (transact.transamerica.com)
TRANSAMERICA_USER_ID=your_user_id
TRANSAMERICA_PASSWORD=your_password

# Alternative portals (if you use Agent Home or TLIC instead)
# AGENT_HOME_USER_ID=your_agent_home_user_id
# AGENT_HOME_PASSWORD=your_agent_home_password

# Portal selection: "transact" | "agent_home" | "tlic"
PORTAL=transact

# Download directory for reports
DOWNLOAD_DIR=./downloads

# PolicyHQ API for reconciliation
POLICYHQ_API_BASE=https://api1.simplyworkcrm.com/api:xyNb4DPW
POLICYHQ_AUTH_TOKEN=your_policyhq_token

# Browser settings
HEADLESS=true
SLOW_MO=0
TIMEOUT=60000
